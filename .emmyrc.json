{
  "$schema": "https://raw.githubusercontent.com/EmmyLuaLs/emmylua-analyzer-rust/refs/heads/main/crates/emmylua_code_analysis/resources/schema.json",
  "diagnostics": {
    "disable": [
      "assign-type-mismatch",
      "undefined-global",
      "undefined-field",
      "param-type-mismatch",
      "missing-fields",
      "need-check-nil"
    ],
    "globals": [
      "ACCEPT",
      "AddonList",
      "AnchorUtil",
      "APIDocumentation",
      "assertsafe",
      "BACKDROP_TOAST_12_12",
      "CANCEL",
      "ChatFrame1",
      "ChatFrame1Tab",
      "ChatTypeInfo",
      "CreateAnchor",
      "CreateColorFromRGBHexString",
      "DEFAULT_CHAT_FRAME",
      "DEVTOOLS_LONG_STRING_CUTOFF",
      "FCF_SetWindowAlpha",
      "FCF_SetWindowColor",
      "FramerateFrame",
      "FrameStackTooltip",
      "FrameUtil",
      "LibStub",
      "NO",
      "OKAY",
      "pformat",
      "PlayerFrame",
      "RaidNotice_AddMessage",
      "RaidWarningFrame",
      "RegisterStateDriver",
      "ReloadUI",
      "SELECTED_CHAT_FRAME",
      "Settings",
      "SettingsPanel",
      "SlashCmdList",
      "SOUNDKIT",
      "StaticPopup_Visible",
      "StaticPopupDialogs",
      "TargetFrame",
      "UIParentLoadAddOn",
      "UISpecialFrames",
      "UIWidgetTopCenterContainerFrame",
      "YES"
    ]
  },
  "workspace": {
    "library": [],
    "ignoreDir": [
      "setup", "img", "luasrc",
      "src", "wowdoc", "build",
      "dist", "doc", "dev",
      "legacy"
    ],
    "ignoreGlobs": [
      "**/_*",
      "**/_*/**",
      "**/.*",
      "**/.*/**"
    ]
  }
}
